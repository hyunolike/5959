API_TAG=latest
# 도메인이 없으면 sslip.io를 쓴다. 예: api.203-0-113-10.sslip.io
API_DOMAIN=

POSTGRES_DB=ogu
POSTGRES_USER=ogu
POSTGRES_PASSWORD=

# 인증(002-auth). JWT_SECRET은 256비트 이상 무작위 문자열로 발급한다
JWT_SECRET=
# BFF가 API를 호출할 때 보내는 비밀 키. BFF_API_KEY(apps/web)와 값이 같아야 한다
OGU_BFF_KEY=
# BFF의 OAuth 콜백 URI 목록(콤마 구분). 쉼표 뒤 공백 없이 적는다
OAUTH_ALLOWED_REDIRECT_URIS=https://<web-domain>/api/auth/oauth/kakao/callback,https://<web-domain>/api/auth/oauth/google/callback
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 감정 분석(003-core-loop). OpenAI 호환 API. AI_API_KEY가 비면 기동하지 않는다(ProdAiSettingsCheck). AI_BASE_URL과 AI_MODEL은 빼면 compose 기본값을 쓴다
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b
# 위험 분류(005-safety)는 더 큰 모델을 따로 쓴다. 빼면 compose 기본값을 쓴다
AI_RISK_MODEL=nvidia/nemotron-3-super-120b-a12b
# AI 친구(009-ai-companions). 꺼진 채로 나간다. 실제 모델의 댓글을 읽어 본 뒤(specs/009-ai-companions/quickstart.md) true로 켠다
AI_COMPANION_ENABLED=false
# 하루(한국 시간)에 AI에 댓글을 청하는 횟수. 댓글 하나에 공급자 호출이 세 번까지 든다
AI_COMPANION_DAILY_LIMIT=45
# 글이 올라온 뒤 다른 회원의 댓글을 기다리는 시간
AI_COMPANION_WAIT=10m
# 한 글에 반응할 AI 친구의 수(1명, 2명, 3명)를 뽑는 무게. 글마다 한 번 정한다(012-companion-activity)
AI_COMPANION_COUNT_WEIGHTS=60,30,10
# 앞 친구의 댓글 뒤 다음 친구가 반응하기까지의 간격. 이 범위에서 무작위로 고른다
AI_COMPANION_FOLLOW_UP_MIN=3m
AI_COMPANION_FOLLOW_UP_MAX=10m
# AI 친구의 글쓰기(012-companion-activity). 반응과 따로 켠다. 꺼진 채로 나간다.
# 실제 모델의 글을 읽어 본 뒤(specs/012-companion-activity/quickstart.md) true로 켠다
AI_COMPANION_POSTING_ENABLED=false
# 이 동안 회원에게 보이는 새 글이 없을 때 AI 친구 한 명이 글 하나를 쓴다
AI_COMPANION_POSTING_QUIET=6h
# 하루(한국 시간)에 올리는 글 수. 친구마다 하루 하나까지다
AI_COMPANION_POSTING_DAILY_POSTS=3

# 실시간 알림(004-notification-mypage). REDIS_PASSWORD는 32자 이상 난수(openssl rand -hex 32). compose가 REDIS_URL을 조합한다
REDIS_PASSWORD=
# 스트림에 바로 붙는 웹 출처(콤마 구분). 예: https://5959.vercel.app. 비면 API가 기동하지 않는다
OGU_SSE_ALLOWED_ORIGINS=

# OpenTelemetry → Grafana Cloud (Connections > OpenTelemetry에서 발급)
JAVA_TOOL_OPTIONS=-javaagent:/app/otel/opentelemetry-javaagent.jar
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# 백업 (rclone이 환경변수로 R2 원격을 구성한다)
R2_BUCKET=ogu-backup
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_ENDPOINT=
# 버킷 범위로 발급한 R2 토큰은 버킷 존재 여부를 확인(HeadBucket)하거나 만들 권한이 없어서 필요하다
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
