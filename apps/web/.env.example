# Copy to .env.local. See src/shared/config/env.ts for the full schema.

# Server-only. Origin of apps/api, called by BFF route handlers.
API_ORIGIN=http://localhost:8080
# Server-only. 브라우저가 실시간 알림 스트림(GET /api/v1/notifications/stream)에 바로 붙을 API 출처(004-notification-mypage).
# 비우면 API_ORIGIN을 쓴다. API의 OGU_SSE_ALLOWED_ORIGINS에 APP_ORIGIN이 들어 있어야 붙는다
SSE_PUBLIC_ORIGIN=

# Auth (002-auth). Server-only unless prefixed NEXT_PUBLIC_.
# API 호출 시 보내는 비밀 키. API 쪽 OGU_BFF_KEY와 값이 같아야 한다
BFF_API_KEY=local-bff-key
# 이 웹 서비스의 출처(Origin 검사, OAuth redirect_uri 구성에 쓴다)
APP_ORIGIN=http://localhost:3000
# KAKAO_CLIENT_ID=
# GOOGLE_CLIENT_ID=
# __Host-ogu_oauth 쿠키 서명 키(32자 이상, openssl rand -base64 48). Vercel 배포(미리보기 포함)와 APP_ENV=production에서는 필수
# OAUTH_STATE_SECRET=
# development | e2e | production. e2e면 OAuth 시작 라우트가 가짜 제공자 흐름을 탄다. VERCEL_ENV=production에서는 e2e를 쓸 수 없다
APP_ENV=development
# NEXT_PUBLIC_SENTRY_DSN=
# 개발/스테이징에서 에러 프로브(테스트용 강제 에러 라우트)를 켤지 여부
ENABLE_ERROR_PROBE=false
